# Build artifacts
bin/

# Generated at build time from configs/defaults.toml
internal/config/defaults_embedded.toml

# OS / editor cruft
.DS_Store
*.swp

# Local task tracker — never publish
.todos/

# Local notes / manual-test scratch — never publish
.local/

# Superpowers local execution reports — never publish
.superpowers/

# Claude Code project state — local only, never publish

# The context-tree opt-in sentinel MUST be tracked: without it in a fresh clone the
# check-context-map-fresh.sh hook silently never fires. Everything else under .claude/
# (settings, worktrees, local state) stays ignored.
.claude/*
!.claude/context-map-required
# NOTE: CLAUDE.md files ARE published — they are the repo's agent-facing context
# tree (root laws + internal/<pkg> leaves), registered in docs/context-map.yaml.
# They were previously ignored here; the pattern is gone because an ignore rule
# would silently swallow any NEW leaf someone adds.

# Internal planning & security-review docs — live in egress-guard-private, never publish
docs/plans/
docs/superpowers/
docs/security-review/
